# ==========================================================================
#  TelemetryFlow - TFO EKS: backend.tf.example
# --------------------------------------------------------------------------
#  Description:
#    Store Terraform State to S3.
#    Rename to backend.tf and edit values to match your account.
# --------------------------------------------------------------------------
terraform {
  backend "s3" {
    region         = "{AWS_DEFAULT_REGION}"
    bucket         = "tfo-tf-state-112233445566-{AWS_DEFAULT_REGION}"
    dynamodb_table = "tfo-ddb-tf-state-112233445566-{AWS_DEFAULT_REGION}"
    key            = "telemetryflow/112233445566/tfo-eks/terraform.tfstate"
    encrypt        = true
  }
}
