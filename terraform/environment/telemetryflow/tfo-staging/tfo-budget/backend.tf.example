# ==========================================================================
#  TelemetryFlow - TFO Budget: backend.tf.example
# --------------------------------------------------------------------------
#  Copy to backend.tf and edit bucket/key for your AWS account.
#  NOTE: backend.tf is gitignored — never commit real account IDs.
# ==========================================================================

terraform {
  backend "s3" {
    region         = "{AWS_DEFAULT_REGION}"
    bucket         = "tfo-tf-state-112233445566-{AWS_DEFAULT_REGION}"
    dynamodb_table = "tfo-ddb-tf-state-112233445566-{AWS_DEFAULT_REGION}"
    key            = "telemetryflow/112233445566/budget/terraform.tfstate"
    encrypt        = true
  }
}
