# ==========================================================================
#  TelemetryFlow - TFO EC2: backend.tf.example
# --------------------------------------------------------------------------
#  Description:
#    Store Terraform State to S3.
#    Rename to backend.tf and edit values to match your account.
# --------------------------------------------------------------------------
terraform {
  backend "s3" {
    region         = "ap-southeast-1"
    bucket         = "tfo-tf-state-112233445566-ap-southeast-1"
    dynamodb_table = "tfo-ddb-tf-state-112233445566-ap-southeast-1"
    key            = "telemetryflow/112233445566/tfo-ec2/terraform.tfstate"
    encrypt        = true
  }
}
