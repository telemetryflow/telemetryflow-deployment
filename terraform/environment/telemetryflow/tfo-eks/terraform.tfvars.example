# ==========================================================================
#  TelemetryFlow - TFO EKS: terraform.tfvars.example
# --------------------------------------------------------------------------
#  Copy to terraform.tfvars and edit for your AWS account.
#  NOTE: *.tfvars is gitignored - never commit real account IDs / IPs.
# ==========================================================================

# --------------------------------------------------------------------------
#  AWS Account / Region
# --------------------------------------------------------------------------
aws_region                      = "ap-southeast-3"
aws_account_id_destination      = "112233445566"
aws_account_profile_destination = "TFO-TF-User-Executor"

# --------------------------------------------------------------------------
#  Tags
# --------------------------------------------------------------------------
department = "DEVOPS"

# --------------------------------------------------------------------------
#  Workspace -> Environment mapping (keep in sync with _tfstate stack)
# --------------------------------------------------------------------------
workspace_env = {
  default = "staging"
  lab     = "lab"
  staging = "staging"
  prod    = "prod"
}

environment = {
  default = "STG"
  lab     = "RND"
  staging = "STG"
  prod    = "PROD"
}

# --------------------------------------------------------------------------
#  Remote State Backend references (must read the tfo-ec2 core stack)
# --------------------------------------------------------------------------
tfstate_bucket         = "tfo-tf-state-112233445566-ap-southeast-3"
tfstate_dynamodb_table = "tfo-ddb-tf-state-112233445566-ap-southeast-3"
tfstate_path           = "telemetryflow/112233445566/tfo-ec2/terraform.tfstate"

# --------------------------------------------------------------------------
#  EKS Cluster
# --------------------------------------------------------------------------
prefix_name      = "observability-tf"
eks_cluster_name = "tfo-eks"
bucket_name      = "tfo-eks-bucket"

# Existing KMS key alias (default: AWS-managed S3 key)
kms_key = {
  default = "alias/aws/s3"
  lab     = "alias/aws/s3"
  staging = "alias/aws/s3"
  prod    = "alias/aws/s3"
}

# Route53 Hosted Zone ID for cert-manager DNS validation (replace with real Zxxx)
dns_zone = {
  default = "Z000000000000ABCDEF000"
  staging = "Z000000000000ABCDEF000"
  prod    = "Z000000000000ABCDEF000"
}

dns_url = {
  default = "staging.telemetryflow.eks"
  lab     = "lab.telemetryflow.eks"
  staging = "staging.telemetryflow.eks"
  prod    = "telemetryflow.eks"
}

# --------------------------------------------------------------------------
#  Node Group (default: 3 x t3.large worker, prod: m5.large)
# --------------------------------------------------------------------------
ssh_key_pair = {
  default = "tfo-ssh-key"
  lab     = "tfo-ssh-key"
  staging = "tfo-ssh-key"
  prod    = "tfo-ssh-key"
}

k8s_version = {
  default = "1.35"
  lab     = "1.35"
  staging = "1.35"
  prod    = "1.35"
}

eks_node_type = {
  default = "t3.large"
  lab     = "t3.large"
  staging = "t3.large"
  prod    = "m5.large"
}

eks_node_storage = {
  default = 50
  lab     = 50
  staging = 50
  prod    = 100
}

node_counts = {
  worker     = 3
  worker_max = 10
  worker_min = 1
}

# --------------------------------------------------------------------------
#  EKS Addons (latest for 1.35 — see terraform/modules/eks/LIST-ADDONS.md)
# --------------------------------------------------------------------------
pod_identity_agent_version = {
  default = "v1.4.0-eksbuild.1"
  staging = "v1.4.0-eksbuild.1"
  prod    = "v1.4.0-eksbuild.1"
}

ebs_csi_driver_version = {
  default = "v1.50.0-eksbuild.1"
  staging = "v1.50.0-eksbuild.1"
  prod    = "v1.50.0-eksbuild.1"
}

efs_csi_driver_version = {
  default = "v2.2.5-eksbuild.1"
  staging = "v2.2.5-eksbuild.1"
  prod    = "v2.2.5-eksbuild.1"
}

kube_proxy_version = {
  default = "v1.35.1-eksbuild.1"
  staging = "v1.35.1-eksbuild.1"
  prod    = "v1.35.1-eksbuild.1"
}

vpc_cni_version = {
  default = "v1.21.0-eksbuild.1"
  staging = "v1.21.0-eksbuild.1"
  prod    = "v1.21.0-eksbuild.1"
}

coredns_version = {
  default = "v1.13.1-eksbuild.1"
  staging = "v1.13.1-eksbuild.1"
  prod    = "v1.13.1-eksbuild.1"
}

snapshot_controller_version = {
  default = "v8.4.0-eksbuild.1"
  staging = "v8.4.0-eksbuild.1"
  prod    = "v8.4.0-eksbuild.1"
}
