# ==========================================================================
#  .gitignore - Terraform
# ==========================================================================

# Terraform state & plans (NEVER commit)
*.tfstate
*.tfstate.backup
*.tfplan
**/terraform.tfstate*
**/*.tfplan

# Terraform working directories
**/.terraform/**
**/.terraform.lock.hcl
terraform.tfstate.d/**

# Backend config (contains account-specific values)
backend.tf
backend.hcl

# tfvars (may contain secrets)
*.tfvars
*.tfvars.json

# OS / Editor
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Logs & archives
*.log
*.zip
*.tgz
