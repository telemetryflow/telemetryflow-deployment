PGADMIN_EMAIL=admin@telemetryflow.id
PGADMIN_PASSWORD=


#================================================================================================
# [25] KUBERNETES / DEPLOYMENT CONFIGURATION (OPTIONAL)
#================================================================================================
CLUSTER_NAME=telemetryflow-staging
K8S_NAMESPACE=telemetryflow
K8S_POD_NAME=tfo-pod
K8S_NODE_NAME=tfo-node
