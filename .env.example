TELEMETRYFLOW_K8S_CLUSTER_ID=


#================================================================================================
# [26] DEFAULT DEMO CONFIGURATION (OTEL Collector)
#================================================================================================
# Default region, workspace, and tenant for internal OTEL collector
# These values are automatically applied to ingested data that doesn't specify them

# Region code (e.g., APS3 = ap-southeast-3 / Asia Pacific - Jakarta)
DEFAULT_REGION_CODE=APS3

# Workspace code
DEFAULT_WORKSPACE_CODE=TELEMETRIDATA-WORKSPACE

# Tenant code
DEFAULT_TENANT_CODE=TELEMETRIDATA


# Default Organization ID for alert rule evaluation
# This is used as fallback when no enabled alert rules are found
# Query your database to get the correct organization ID:
#   SELECT id FROM organizations WHERE name = 'Your Organization Name';
# Leave empty to use 'default' as fallback
# DEFAULT_ORGANIZATION_ID=8bbb205e-ca2a-4d3e-ac99-11516d0753ff
DEFAULT_ORGANIZATION_ID=

# DB Monitoring: allow connecting to internal/private database hosts (Docker, localhost, etc.)
# Set to 'true' when the platform monitors its OWN databases (self-monitoring).
# Default: false (secure — blocks SSRF via connection-test endpoint).
DB_MONITORING_ALLOW_INTERNAL_HOSTS=true

#================================================================================================
# PRODUCTION DEPLOYMENT SECURITY CHECKLIST
#================================================================================================
#
# Before deploying to production, ensure ALL items are checked:
#
# [ ] JWT_SECRET rotated (32+ char random string via pnpm generate:secrets)
# [ ] JWT_REFRESH_SECRET rotated (32+ char random string)
# [ ] SESSION_SECRET rotated (32+ char, different from JWT)
# [ ] ENCRYPTION_KEY rotated (32+ char random string)
# [ ] MFA_ENCRYPTION_KEY rotated (32+ char random string)
# [ ] LLM_ENCRYPTION_KEY rotated (32+ char random string)
# [ ] CORS_ORIGIN set to https://telemetryflow.id (no wildcard)
# [ ] POSTGRES_PASSWORD provisioned via ESO/Vault (tfo-postgresql-secret)
# [ ] CLICKHOUSE_PASSWORD provisioned via ESO/Vault (tfo-clickhouse-secret)
# [ ] REDIS_PASSWORD provisioned via ESO/Vault (tfo-redis-secret)
# [ ] SMTP_USER / SMTP_PASSWORD provisioned via ESO/Vault
# [ ] TELEMETRYFLOW_API_KEY_ID / SECRET provisioned via ESO/Vault (tfo-agent-secret)
# [ ] TELEMETRYFLOW_VIZ_EMAIL / USERNAME / PASSWORD empty (backend auth only)
# [ ] All K8s secrets created BEFORE helm upgrade (secrets.create=false)
# [ ] HTTPS/TLS terminated at reverse proxy (nginx/traefik)
# [ ] Security headers validated (run: npm run test:security)
# [ ] SMTP_ENABLED=true with production SMTP server
# [ ] TELEMETRYFLOW_USE_MOCK=false
# [ ] NODE_ENV=production
# [ ] JWT_ACCESS_EXPIRY=15m (strict production token expiry)
# [ ] Database pool: DATABASE_POOL_SIZE=50 (3 replicas × 50 = 150 max connections)
# [ ] Monitoring and alerting configured
# [ ] Backup enabled (postgresql.backup.enabled=true in manifest)
# [ ] Network policies enabled (networkPolicies.enabled=true in manifest)
#
# Generate Secure Secrets:
#   pnpm run generate:secrets
#
# Test Security Configuration:
#   npm run test:security
#
# For complete deployment guide, see:
#   - _infra/docs/install-tfo-production.md
#   - docs/security/guides/PRODUCTION_SECURITY_GUIDE.md
#   - docs/security/SECURITY_QUICK_REFERENCE.md
#
#================================================================================================
